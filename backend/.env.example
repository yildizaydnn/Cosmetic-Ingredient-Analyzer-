# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun:
#   cp .env.example .env
#
# NOT: Sayısal alanları boş bırakmayın — boş değer pydantic doğrulamasında
# hata verir ve uygulama açılmaz. Değiştirmek istemiyorsanız satırı silin,
# config.py'deki varsayılan kullanılır.

# --- Veritabanı ---
# docker-compose ile çalışırken host adı "db" olmalıdır:
#   postgresql+asyncpg://skincare:skincare_dev@db:5432/skincare
DATABASE_URL=postgresql+asyncpg://skincare:skincare_dev@localhost:5432/skincare

# --- Eşleştirme / sınıflandırma eşikleri ---
MATCH_THRESHOLD=85
SCORE_BENEFICIAL_THRESHOLD=2.0
SCORE_CAUTION_THRESHOLD=-1.0

# --- Pozisyon ağırlıkları ---
POSITION_WEIGHT_TOP=1.0
POSITION_WEIGHT_MID=0.5
POSITION_WEIGHT_LOW=0.2

# --- Feedback öğrenme motoru ---
LEARNING_RATE=0.01
MIN_FEEDBACK_THRESHOLD=20
MAX_DELTA=2.0

# --- Veri kaynağı (uvicorn'un çalıştığı dizine göre göreli) ---
MASTER_CSV_PATH=data/master_expanded.csv

# --- AI anahtarları (opsiyonel) ---
# Boş bırakılırsa AI adımları atlanır; uygulama yalnızca CSV sözlüğüyle çalışır.
# OPENROUTER_API_KEY  → fotoğraftan INCI okuma (vision OCR)
# DEEPSEEK_API_KEY    → OCR düzeltme, bilinmeyen madde analizi, ürün özeti
# GEMINI_API_KEY      → şu an kullanılmıyor, ileride kullanılmak üzere ayrılmış
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
